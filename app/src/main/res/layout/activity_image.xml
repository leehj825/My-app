<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/image_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/image_hint"
            android:inputType="textMultiLine|textCapSentences" />

        <EditText
            android:id="@+id/image_negative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/image_negative_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/image_gemini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/image_gemini_label"
            android:visibility="gone" />

        <Button
            android:id="@+id/image_load_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_load_model" />

        <Spinner
            android:id="@+id/image_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/image_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/image_sampler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <EditText
            android:id="@+id/image_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/image_steps_hint"
            android:inputType="number"
            android:visibility="gone" />

        <EditText
            android:id="@+id/image_threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/image_threads_hint"
            android:inputType="number"
            android:visibility="gone" />

        <EditText
            android:id="@+id/image_seed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/image_seed_hint"
            android:inputType="number"
            android:visibility="gone" />

        <Button
            android:id="@+id/image_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_generate" />

        <TextView
            android:id="@+id/image_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true" />

        <TextView
            android:id="@+id/image_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
