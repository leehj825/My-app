<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground services: screen capture and the floating button. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Notifications: recording status and Stop buttons (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The floating button over other apps. The user allows it in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyApp">

        <!-- The home screen: lists the tools in this app. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tools. Each one is an activity here and is listed in Tools.kt. -->
        <activity
            android:name=".recorder.ScreenRecorderActivity"
            android:exported="false" />

        <!-- Invisible activity that shows the system screen capture prompt. -->
        <activity
            android:name=".recorder.CaptureRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.MyApp.Transparent" />

        <service
            android:name=".recorder.RecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".recorder.FloatingButtonService"
            android:exported="false" />

        <!-- Quick Settings tile: start and stop from the notification shade. -->
        <service
            android:name=".recorder.ScreenRecorderTileService"
            android:exported="true"
            android:icon="@android:drawable/presence_video_online"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
