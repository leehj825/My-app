<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground services: screen capture and the floating button. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Notifications: recording status, Stop buttons, the journal reminder (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Microphone and app audio in the recording (optional: if refused, the video has no sound). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The floating button over other apps. The user allows it in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Fingerprint or screen lock to open secure notes. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Sets the journal reminder again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the notes screen find the phone's speech recognizer (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognizerIntent.ACTION_RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyApp">

        <!-- The home screen: lists the tools in this app. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tools. Each one is an activity here and is listed in Tools.kt. -->
        <activity
            android:name=".recorder.ScreenRecorderActivity"
            android:exported="false" />

        <activity
            android:name=".notes.NotesActivity"
            android:exported="false" />

        <activity
            android:name=".notes.NoteEditActivity"
            android:exported="false" />

        <activity
            android:name=".journal.JournalActivity"
            android:exported="false" />

        <activity
            android:name=".voice.VoiceSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".secure.SecureNotesActivity"
            android:exported="false" />

        <!-- Invisible activity that shows the system screen capture prompt. -->
        <activity
            android:name=".recorder.CaptureRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.MyApp.Transparent" />

        <service
            android:name=".recorder.RecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <service
            android:name=".recorder.FloatingButtonService"
            android:exported="false" />

        <!-- The journal reminder alarm, and the restart that sets it again. -->
        <receiver
            android:name=".journal.JournalReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".journal.JournalBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile: start and stop from the notification shade. -->
        <service
            android:name=".recorder.ScreenRecorderTileService"
            android:exported="true"
            android:icon="@android:drawable/presence_video_online"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
